[Unit]
Description=Ramen MES Production Worker
After=network.target

[Service]
Type=simple
User=smart
WorkingDirectory=/home/smart/work/mespython
Environment=PYTHONUNBUFFERED=1
Environment=MES_PRODUCTION_INTERVAL_SECONDS=5
ExecStart=/home/smart/work/mespython/.venv/bin/python -m workers.production_worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
